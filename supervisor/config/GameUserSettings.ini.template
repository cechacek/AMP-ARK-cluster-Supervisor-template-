; ============================================================================
;  GameUserSettings.ini - SDILENY pro vsechny mapy clusteru
;
;  TENHLE SOUBOR SE GENERUJE - viz Game.ini.template.
;
;  ARK si tenhle soubor pri vypnuti PREPISUJE vlastnimi hodnotami. Proto ho
;  supervisor po zapsani nastavi na chmod 444 - jinak by se konfigurace
;  postupne rozjela mezi mapami a nikdo by nevedel proc.
;
;  Nasobky rychlosti tu ZAMERNE NEJSOU: jdou na prikazovou radku, aby se
;  daly menit eventem bez prepisovani souboru. Duplikovat je i sem by
;  akorat matlo, kdyz by se hodnoty rozesly.
; ============================================================================
[ServerSettings]
ServerAdminPassword={{RCON_PASSWORD}}
ItemStackSizeMultiplier=10.0
AllowThirdPersonPlayer=True
ShowMapPlayerLocation=True
ServerCrosshair=True
AllowHideDamageSourceFromLogs=False
RCONServerGameLogBuffer=600

[SessionSettings]
SessionName={{SESSION_NAME}}

[/Script/Engine.GameSession]
MaxPlayers={{MAX_PLAYERS}}
