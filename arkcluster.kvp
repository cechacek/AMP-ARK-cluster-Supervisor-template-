Meta.DisplayName=ARK: Survival Evolved (Cluster)
Meta.Description=Cely ARK cluster v JEDNE instanci. Zaskrtnes mapy, ktere chces, a Python supervisor uvnitr spusti vsechny nad jednou instalaci hry (~15 GB misto 13x15 GB) se sdilenou konfiguraci. Ovladani jednotlivych map zustava granularni pres konzoli AMP.
Meta.OS=Linux
Meta.AarchSupport=None
Meta.Arch=x86_64
Meta.Author=cechacek
Meta.URL=https://github.com/cechacek/AMP-ARK-cluster-Supervisor-template-
Meta.DisplayImageSource=steam:346110
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}
Meta.ConfigManifest=arkclusterconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=arkcluster.kvp
Meta.MinAMPVersion=2.5.1.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=0adf0c56-665d-4e0d-9959-0c4da793962f
Meta.AppIsMultiIPAware=True
App.DisplayName=ARK: Survival Evolved (Cluster)
App.RootDir=./arkcluster/
App.BaseDirectory=./arkcluster/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=venv/bin/python3
App.WorkingDir=supervisor
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-u arkclustersupervisor.py {{MapIsland}}{{MapCenter}}{{MapScorched}}{{MapRagnarok}}{{MapAberration}}{{MapExtinction}}{{MapValguero}}{{MapGenesis}}{{MapCrystalIsles}}{{MapGen2}}{{MapLostIsland}}{{MapFjordur}}{{MapAquatica}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"VIRTUAL_ENV":"{{$FullBaseDir}}venv","PATH":"{{$FullBaseDir}}venv/bin:%PATH%","PYTHONHOME":"","LD_LIBRARY_PATH":"{{$FullBaseDir}}376030/linux64:{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%","SteamAppId":"346110","ARK_BASE_DIR":"{{$FullBaseDir}}","ARK_SESSION_NAME":"{{SessionName}}","ARK_CLUSTER_ID":"{{ClusterId}}","ARK_RCON_PASSWORD":"{{RconPassword}}","ARK_SERVER_PASSWORD":"{{ServerPassword}}","ARK_MAX_PLAYERS":"{{MaxPlayersPerMap}}","ARK_START_DELAY":"{{StartDelay}}","ARK_READY_TIMEOUT":"{{ReadyTimeout}}","ARK_SAVE_TIMEOUT":"{{SaveTimeout}}","ARK_EXIT_TIMEOUT":"900","ARK_HIVE_CLEANUP":"{{HiveCleanup}}","ARK_CPU_PINNING":"{{CpuPinning}}","ARK_AUTO_RESTART":"{{AutoRestart}}","ARK_CROSS_CHAT":"{{CrossChat}}","ARK_RATE_PRESET":"{{RatePreset}}","ARK_CUSTOM_OPTIONS":"{{CustomOptions}}","ARK_GAME_PORT":"{{$GamePort}}","ARK_QUERY_PORT":"{{$QueryPort}}","ARK_RCON_PORT":"{{$RCONPort}}","ARK_BIND_IP":"{{$ApplicationIPBinding}}"}
App.CommandLineParameterFormat={0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=900
App.ExitString=DoExit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[arkclusterports.json]
App.AdminPortRef=RCONPort
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=GamePort
App.UniversalSleepSteamQueryPortRef=QueryPort
App.MaxUsers=910
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[arkclusterupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeSupported=True
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua","*.ark","*.arkprofile","*.arktribe","*.arktributetribe","*.profilebak","*.tribebak"]
App.QuiesceCommand=quiesce
App.DequiesceCommand=dequiesce
App.QuiesceSettleDelayMilliseconds=2000
App.MonitorChildProcess=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessWaitMs=100
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^\[[^\]]+\] (Keep Alive|\[S_API FAIL\] SteamAPI_Init\(\) failed; SteamAPI_IsSteamRunning\(\) failed\.|Server received, But no response!!|Setting breakpad minidump AppID = 346110)\s*$
Console.AppReadyRegex=^$
Console.UserJoinRegex=^\[.+?\] >>> (?<username>.+?) joined this ARK!$
Console.UserLeaveRegex=^\[.+?\] <<< (?<username>.+?) left this ARK!$
Console.UserChatRegex=^\[.+?\] <(?<username>.+?)> (?<message>.+)$
Console.UpdateAvailableRegex=^\[supervisor\] A new server update is available!$
Console.MetricsRegex=^\[supervisor\] METRICS maps_up=(?<Maps_Up>\d+) players=(?<Players>\d+)$
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.HideFromConsoleRegex=^\[.+?\] (?:Full Startup:|Number of cores|VERBOSE)
Console.UserActions={"Kick": "kick {{userid}}", "Ban": "ban {{userid}}", "Whereis": "whereis {{userid}}"}
Limits.SleepMode=True
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
